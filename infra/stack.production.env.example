# Variáveis da stack infra/stack.production.yml para o Portainer.
# Use valores fictícios somente para a apresentação.

GHCR_OWNER=seu-usuario-ou-organizacao
IMAGE_TAG=latest
WEB_HOST=clinicaescola.forlium.com
API_HOST=apiclinicaescola.forlium.com

POSTGRES_DB=clinica_escola
POSTGRES_USER=clinica
POSTGRES_PASSWORD=troque-por-uma-senha-do-banco
DATABASE_URL=postgresql+psycopg://clinica:troque-por-uma-senha-do-banco@db:5432/clinica_escola

# Gere um valor longo e aleatório antes do deploy.
JWT_SECRET_KEY=troque-por-um-segredo-longo-e-aleatorio

# Os DEMO_* têm defaults fictícios no compose; personalize-os se quiser.
# DEMO_MASTER_EMAIL=master.demo@demo.clinicaescola.dev
# DEMO_MASTER_PASSWORD=MasterDemo!2026
# DEMO_SUPERVISOR_EMAIL=supervisor.demo@demo.clinicaescola.dev
# DEMO_SUPERVISOR_PASSWORD=SupervisorDemo!2026
# DEMO_STUDENT_EMAIL=student.demo@demo.clinicaescola.dev
# DEMO_STUDENT_PASSWORD=StudentDemo!2026
